<?xml version="1.0" encoding="utf-8"?>
<!-- Local-only tool: never back up settings, database, or reports (token is app-private too). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
